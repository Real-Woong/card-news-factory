# Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# mock      : 네트워크 없이 규칙 기반 응답. **명시적으로 mock 일 때만** 사용됩니다.
#             (초안 문장이 기계적이므로 파이프라인 검증 용도)
# kiro_cli  : Kiro CLI 를 subprocess 로 호출 (API 키 불필요)
# openai    : OPENAI_API_KEY 필요
# anthropic : ANTHROPIC_API_KEY 필요
#
# 중요: mock 이외의 provider 를 지정했는데 사용할 수 없으면 파이프라인은
# mock 으로 폴백하지 않고 종료 코드 2 로 실패합니다. 자동 실행 중 provider 가
# 죽었을 때 가짜 문장이 게시 후보로 만들어지는 것을 막기 위한 정책입니다.
LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Kiro CLI 실행 커맨드. 비워 두면 다음 순서로 자동 탐색합니다.
#   1) KIRO_CLI_COMMAND
#   2) which kiro-cli → which kiro
#   3) ~/.local/bin/kiro-cli
# 프롬프트는 stdin 으로 전달됩니다.
# 예: KIRO_CLI_COMMAND=~/.local/bin/kiro-cli chat --no-interactive --trust-tools=
KIRO_CLI_COMMAND=
# 한 번의 호출 제한 시간(초). 에이전트 프롬프트는 길어서 여유를 둡니다.
KIRO_CLI_TIMEOUT=300
# 호출별 크레딧을 읽으려고 Kiro 출력을 stream-json 으로 받습니다(기본 1). 문제가 생기면 0 으로 끄면 일반 텍스트로 돌아갑니다.
# KIRO_STREAM_JSON=1

# ---------------------------------------------------------------------------
# Embeddings / RAG
# ---------------------------------------------------------------------------
# hashing             : dependency-free deterministic embeddings (default)
# sentence_transformers: local model, requires the `embeddings` extra
# openai              : requires OPENAI_API_KEY
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# local  : built-in JSON vector store (default, zero dependencies)
# chroma : ChromaDB persistent client, requires the `rag` extra
VECTOR_STORE=local

# ---------------------------------------------------------------------------
# Collectors
# ---------------------------------------------------------------------------
# Optional. Raises the GitHub API rate limit from 60 to 5000 req/h.
GITHUB_TOKEN=

# Sent with every outbound HTTP request.
HTTP_USER_AGENT=Project-ContentOps/0.1 (+https://github.com/your-handle/Project_ContentOps)

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Override the timezone used for run stamps / launchd schedules.
CONTENTOPS_TZ=Asia/Seoul

# ---------------------------------------------------------------------------
# Publishing (secrets are environment-only; never commit real values)
# ---------------------------------------------------------------------------
# Instagram API with Instagram Login. The publisher additionally requires
# channel.publish=true, phase=3, a current human approval, and a matching
# public-JPEG media manifest before it makes any network request.
# 토큰은 약 60일 뒤 만료됩니다. 무인 실행이 주 1회 자동 갱신하며 갱신본은 ~/.r_a_glance/ 에 저장되고 이 파일은
# 바뀌지 않습니다. 토큰을 직접 새로 만들어 이 줄에 넣으면 그 값이 우선합니다.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# 휴대폰 알림용 텔레그램 봇(이 채널 전용): BotFather 에서 봇을 만들어 토큰을 받고, 봇에게 말을 건 뒤
# `python -m channel.src.telegram_notify --discover` 로 채팅 ID 를 찾습니다. 둘 다 있어야 알림이 켜집니다.
RAG_TELEGRAM_BOT_TOKEN=
RAG_TELEGRAM_CHAT_ID=
# (짧은 이름도 인식합니다: TELEGRAM_BOT = 토큰, TELEGRAM_ALLOWED_USER_ID = 채팅 ID. 개인 채팅에서는 내 사용자 ID 가
#  곧 채팅 ID 이며, 그 계정으로 봇에게 먼저 /start 를 눌러야 봇이 메시지를 보낼 수 있습니다.)

# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# LINKEDIN_ACCESS_TOKEN=
# THREADS_ACCESS_TOKEN=
